// Configuração do Cloudflare (Worker "ledixplugins-github-io").
// O site é estático: o Cloudflare publica os arquivos desta pasta a cada push no main.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ledixplugins-github-io",
  "compatibility_date": "2025-09-01",
  // Script que serve o AURA Tone e o AURA Synth na raiz dos seus subdomínios.
  "main": "./worker.js",
  // Endereços próprios (o Cloudflare cria o DNS sozinho): AURA Tone e a versão online secreta do AURA Synth.
  "routes": [
    { "pattern": "tone.ledixplugins.com.br", "custom_domain": true },
    { "pattern": "synth.ledixplugins.com.br", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./",
    // Página que não existe → mostra o 404.html com status 404.
    "not_found_handling": "404-page",
    // /aurabass → /aurabass/ (igual ao GitHub Pages).
    "html_handling": "auto-trailing-slash"
  }
}
